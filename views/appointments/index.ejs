<% layout('layouts/boilerplate') -%>

<div class="container-fluid py-4 px-4">

    <h2 class="mb-4 fw-bold">📋 My Appointments</h2>

    <% if (!appointments || appointments.length === 0) { %>

        <div class="alert alert-info">
            No appointments yet.
        </div>

    <% } else { %>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            <% appointments.forEach(appt => { %>

                <div class="col">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        <div class="card-body p-4">

                            <!-- SERVICE + STATUS -->
                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <h5 class="fw-bold mb-0">
                                    ✂️ <%= appt.service %>
                                </h5>

                                <% if(appt.status === "Confirmed") { %>
                                    <span class="badge bg-success">Confirmed</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } %>

                            </div>

                            <p class="mb-1"><strong>Name:</strong> <%= appt.name %></p>

                            <p class="mb-1"><strong>Phone:</strong> <%= appt.phone %></p>

                            <p class="mt-3 text-muted">
                                📅 <%= new Date(appt.date).toDateString() %>
                            </p>

                            <!-- CANCEL BUTTON -->
                            <form action="/appointments/<%= appt._id %>?_method=DELETE" method="POST" style="display:inline;">
                                <button class="btn btn-danger btn-sm mt-3">
                                    Cancel
                                </button>
                            </form>

                        </div>

                    </div>

                </div>
            <% }) %>
        </div>
    <% } %>
</div>