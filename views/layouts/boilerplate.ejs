<!DOCTYPE html>
<html>
<head>
    <title>PetNest</title>

    <link rel="stylesheet" href="/css/style.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&family=Pacifico&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <!-- NAVBAR -->
    <div class="navbar">

        <!-- LEFT -->
        <div class="nav-left">

    <span class="logo">
        <i class="fa-solid fa-paw"></i> PetNest
    </span>

    <a href="/dashboard" class="btn add-btn">
    📊 Dashboard
    </a>

    <% if(currUser){ %>
        <a href="/appointments" class="btn add-btn">
            My Appointments
        </a>
    <% } %>

</div>

        <!-- CENTER -->
<div class="nav-center">
    <form action="/appointments" method="GET" style="display:flex; align-items:center; gap:6px; margin:0;">
        <input 
            type="search" 
            name="q" 
            placeholder="Search..." 
            style="padding:6px 10px; border-radius:6px; border:1px solid #ccc; outline:none; height:36px;">
        
        <button type="submit" style="border:none; background:none; display:flex; align-items:center;">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </form>
</div>
        <!-- RIGHT -->
        <div class="nav-right">

            <% if(!currUser){ %>
                <a href="/login" class="btn btn-success btn-sm">Login</a>
                <a href="/signup" class="btn btn-success btn-sm">Sign Up</a>
            <% } else { %>
                <a href="/logout" class="btn btn-danger btn-sm">Logout</a>
            <% } %>

        </div>

    </div>

    <!-- FLASH MESSAGES -->
    <% if(success.length > 0){ %>
        <div class="flash success-msg"><%= success %></div>
    <% } %>

    <% if(error.length > 0){ %>
        <div class="flash error-msg"><%= error %></div>
    <% } %>

    <!-- PAGE CONTENT -->
    <%- body %>

    <!-- FOOTER -->
    <div class="footer">

        <div class="icons">
            <i class="fa-brands fa-instagram"></i>
            <i class="fa-brands fa-facebook"></i>
            <i class="fa-brands fa-twitter"></i>
        </div>

        <p>© 2026 PetNest Private Limited</p>

        <div class="text-center mt-5">
            <a href="/privacy" class="me-3">Privacy Policy</a>
            <a href="/terms">Terms & Conditions</a>
        </div>

    </div>

</body>
</html>