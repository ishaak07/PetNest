<% layout('layouts/boilerplate') %>

<div class="container service-container">

    <h1 class="service-title">🐾 Vet Care Services</h1>

    <div class="card-box">
        <p>
            Our Vet Care service provides complete medical support for your pets.
            From routine checkups to emergency treatments, we ensure professional care.
        </p>
    </div>

    <div class="card-box">
        <h3>💰 Pricing</h3>
        <ul>
            <li>Basic Health Checkup - <span class="price">₹499</span></li>
            <li>Full Body Examination - <span class="price">₹999</span></li>
            <li>Vaccination Package - <span class="price">₹799 - ₹1499</span></li>
            <li>Emergency Visit - <span class="price">₹1499+</span></li>
        </ul>
    </div>

    <div class="card-box">
        <h3>⏱ Duration</h3>
        <ul>
            <li>Basic Checkup: 20–30 mins</li>
            <li>Full Examination: 45–60 mins</li>
            <li>Vaccination: 15–20 mins</li>
            <li>Emergency: As per condition</li>
        </ul>
    </div>

    <div class="card-box">
        <h3>🩺 Services Included</h3>
        <ul>
            <li>✔ General health check-up</li>
            <li>✔ Vaccinations</li>
            <li>✔ Deworming</li>
            <li>✔ Infection diagnosis</li>
            <li>✔ Minor wound treatment</li>
        </ul>
    </div>

    <div class="card-box">
        <h3>🚑 Emergency Care</h3>
        <p>
            24/7 emergency support for accidents and critical health conditions.
        </p>
    </div>

</div>
<div style="text-align:center; margin: 20px 0;">
    <a href="/appointments/new?service=Veterinary"
       class="btn btn-primary btn-sm"
       style="display:inline-flex; align-items:center; justify-content:center; width:auto;">
        Book Appointment
    </a>
</div>