<% layout('layouts/boilerplate') %>

<div style="max-width:900px; margin:40px auto;">

    <h2 style="text-align:center; font-weight:700; margin-bottom:25px;">
        ⚡ Easy Booking
    </h2>

    <p style="text-align:center; color:#555; margin-bottom:30px;">
        Booking your pet services is quick, simple, and hassle-free.
        Just follow these steps and you're done!
    </p>

    <div style="display:flex; flex-direction:column; gap:15px;">

        <div class="card p-3 shadow-sm">
            <h5>1️⃣ Choose a Service</h5>
            <p>Select from grooming, vet care, training, or pet sitting.</p>
        </div>

        <div class="card p-3 shadow-sm">
            <h5>2️⃣ Fill Your Details</h5>
            <p>Enter your pet’s details, preferred date, and contact info.</p>
        </div>

        <div class="card p-3 shadow-sm">
            <h5>3️⃣ Confirm Booking</h5>
            <p>Submit the form and your appointment will be scheduled instantly.</p>
        </div>

        <div class="card p-3 shadow-sm">
            <h5>4️⃣ Track Easily</h5>
            <p>View and manage all your appointments from your dashboard.</p>
        </div>

    </div>

    <div style="text-align:center; margin-top:30px;">
        <a href="/#services" class="btn btn-success">
            Explore Services
        </a>
    </div>

</div>